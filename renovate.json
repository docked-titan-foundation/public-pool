{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranches": ["main"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "reviewers": ["albertoig"],
  "assignees": ["albertoig"],
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "3 days",
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "dependencies",
      "addLabels": ["docker"]
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "dependencies",
      "addLabels": ["github-actions"]
    },
    {
      "matchManagers": ["npm"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "dependencies",
      "addLabels": ["npm"]
    },
    {
      "description": "Upstream public-pool source bumps change what the pool actually does — including how it builds the coinbase output that pays out a found block. These are never auto-merged and get a longer soak.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["benjamin-wilson/public-pool"],
      "semanticCommitType": "feat",
      "semanticCommitScope": "public-pool",
      "addLabels": ["upstream", "review-required"],
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "commitBody": "Upstream source bump. Review the diff before merging: this code constructs\nthe block template's coinbase output."
    }
  ],
  "customManagers": [
    {
      "description": "Track the pinned upstream public-pool commit (upstream publishes no tags or releases).",
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG PUBLIC_POOL_COMMIT=(?<currentDigest>[a-f0-9]{40})"],
      "depNameTemplate": "benjamin-wilson/public-pool",
      "packageNameTemplate": "https://github.com/benjamin-wilson/public-pool",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    }
  ]
}
